{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tft:ppo:observation-schema:v1-draft",
  "title": "TFT PPO Observation Snapshot — Draft v1",
  "description": "DRAFT, NOT APPROVED. Semantic source contract for observations consumed by PPO. The tensor projection is separately versioned and generated/validated from this contract. Action values and action masks remain in the independent Action Contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "catalogs",
    "player",
    "entities",
    "derived_context",
    "strategic_evidence",
    "legal_state_context"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identityStatus": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "session_only",
        "missing",
        "stale",
        "incompatible"
      ]
    },
    "fieldStatus": {
      "type": "string",
      "enum": [
        "valid",
        "partial",
        "missing",
        "unknown",
        "not_applicable",
        "stale",
        "incompatible"
      ]
    },
    "fieldNature": {
      "type": "string",
      "enum": [
        "observed",
        "derived",
        "estimated",
        "inferred",
        "recommended"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_path",
        "nature"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "nature": {
          "$ref": "#/$defs/fieldNature"
        },
        "formula_id": {
          "type": "string"
        },
        "formula_version": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string"
        },
        "catalog_hash": {
          "$ref": "#/$defs/sha256"
        },
        "source_sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "nature",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/fieldStatus"
        },
        "nature": {
          "$ref": "#/$defs/fieldNature"
        },
        "unit": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "missing",
                  "unknown",
                  "not_applicable",
                  "stale",
                  "incompatible"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "version",
        "content_hash",
        "order_hash"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "order_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "champion_id",
        "star",
        "position",
        "items",
        "traits"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "champion_id": {
          "type": "string",
          "minLength": 1
        },
        "star": {
          "$ref": "#/$defs/field"
        },
        "position": {
          "$ref": "#/$defs/field"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "combat_stats": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_index",
        "presence"
      ],
      "properties": {
        "slot_index": {
          "type": "integer",
          "minimum": 0
        },
        "presence": {
          "type": "string",
          "enum": [
            "occupied",
            "empty",
            "unknown",
            "stale",
            "incompatible"
          ]
        },
        "unit": {
          "oneOf": [
            {
              "$ref": "#/$defs/unit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required when presence=occupied; null for empty/unknown slots."
        }
      }
    },
    "sequenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "player_id",
        "round",
        "decision_sequence",
        "snapshot_sequence",
        "status"
      ],
      "properties": {
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "engine_match_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_match_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "episode_id": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "player_id": {
          "type": "string",
          "minLength": 1
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "decision_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "player_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "event_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/identityStatus"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "version",
        "projection_hash",
        "dtype",
        "blocks"
      ],
      "properties": {
        "projection_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "projection_hash": {
          "$ref": "#/$defs/sha256"
        },
        "dtype": {
          "type": "string",
          "enum": [
            "float32",
            "float16",
            "bfloat16",
            "structured"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "source_paths",
              "encoding",
              "consumers"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "source_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "encoding": {
                "type": "string"
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "padding_policy": {
                "type": "string"
              },
              "presence_mask_path": {
                "type": "string"
              },
              "consumers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "semantic_version",
        "structural_revision",
        "schema_hash",
        "projection"
      ],
      "properties": {
        "schema_id": {
          "const": "tft.ppo.observation"
        },
        "semantic_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "structural_revision": {
          "type": "integer",
          "minimum": 1
        },
        "schema_hash": {
          "$ref": "#/$defs/sha256"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "compatibility_policy": {
          "type": "string",
          "enum": [
            "compatible",
            "semantic_break",
            "structural_break",
            "explicit_migration_required",
            "new_training_lineage_required"
          ]
        }
      }
    },
    "identity": {
      "$ref": "#/$defs/sequenceIdentity"
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "champions",
        "traits",
        "items",
        "components",
        "recipes"
      ],
      "properties": {
        "champions": {
          "$ref": "#/$defs/catalog"
        },
        "traits": {
          "$ref": "#/$defs/catalog"
        },
        "items": {
          "$ref": "#/$defs/catalog"
        },
        "components": {
          "$ref": "#/$defs/catalog"
        },
        "recipes": {
          "$ref": "#/$defs/catalog"
        },
        "trait_milestones": {
          "$ref": "#/$defs/catalog"
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "health",
        "economy"
      ],
      "properties": {
        "lifecycle": {
          "$ref": "#/$defs/field"
        },
        "health": {
          "$ref": "#/$defs/field"
        },
        "economy": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "streaks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board",
        "bench",
        "shop"
      ],
      "properties": {
        "board": {
          "type": "array",
          "minItems": 28,
          "maxItems": 28,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "bench": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "shop": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "component_id",
                  "count"
                ],
                "properties": {
                  "component_id": {
                    "type": "string"
                  },
                  "count": {
                    "$ref": "#/$defs/field"
                  }
                }
              }
            },
            "inventory": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "item_id",
                  "slot"
                ],
                "properties": {
                  "item_id": {
                    "type": "string"
                  },
                  "slot": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "pending_anvil": {
              "$ref": "#/$defs/field"
            }
          }
        }
      }
    },
    "derived_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positioning": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "trait_counts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "unit_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instance_id",
              "role"
            ],
            "properties": {
              "instance_id": {
                "type": "string"
              },
              "role": {
                "$ref": "#/$defs/field"
              }
            }
          }
        },
        "unit_fit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instance_id",
              "score"
            ],
            "properties": {
              "instance_id": {
                "type": "string"
              },
              "score": {
                "$ref": "#/$defs/field"
              }
            }
          }
        },
        "item_target_fit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "target_instance_id",
              "score"
            ],
            "properties": {
              "item_id": {
                "type": "string"
              },
              "target_instance_id": {
                "type": "string"
              },
              "score": {
                "$ref": "#/$defs/field"
              }
            }
          }
        },
        "economic_context": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "strategic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composition_hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hypothesis_id",
              "evidence"
            ],
            "properties": {
              "hypothesis_id": {
                "type": "string"
              },
              "direction_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "composition_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "anchor_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "quality": {
                "$ref": "#/$defs/fieldStatus"
              }
            }
          }
        },
        "priorities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity_id",
              "priority"
            ],
            "properties": {
              "entity_id": {
                "type": "string"
              },
              "priority": {
                "$ref": "#/$defs/field"
              }
            }
          }
        },
        "progression": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "pressure": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "legal_state_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/fieldStatus"
        },
        "history_summary": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "anti_loop_state": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "source_decision_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "description": {
          "const": "Descriptive state/history context only. Actual action masks and action legality are defined by the independent Action Contract."
        }
      }
    },
    "shadow_recommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_input_eligible",
        "items"
      ],
      "properties": {
        "policy_input_eligible": {
          "const": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "recommendation_id",
              "action",
              "source_sequence"
            ],
            "properties": {
              "recommendation_id": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "source_sequence": {
                "type": "integer",
                "minimum": 0
              },
              "score": {
                "$ref": "#/$defs/field"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
