{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tft:ppo:observation-schema:v1-draft",
  "title": "TFT PPO Observation Snapshot — Draft v1",
  "description": "DRAFT, NOT APPROVED. Semantic source contract for observations consumed by PPO. The tensor projection is separately versioned and generated/validated from this contract. Action values and action masks remain in the independent Action Contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "catalogs",
    "player",
    "entities",
    "derived_context",
    "strategic_evidence",
    "legal_state_context"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identityStatus": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "session_only",
        "missing",
        "stale",
        "incompatible"
      ]
    },
    "fieldStatus": {
      "type": "string",
      "enum": [
        "valid",
        "partial",
        "missing",
        "unknown",
        "not_applicable",
        "stale",
        "incompatible"
      ]
    },
    "fieldNature": {
      "type": "string",
      "enum": [
        "observed",
        "derived",
        "estimated",
        "inferred",
        "recommended"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_path",
        "nature"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "formula_id": {
          "type": "string"
        },
        "formula_version": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string"
        },
        "catalog_hash": {
          "$ref": "#/$defs/sha256"
        },
        "source_sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "nature",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/fieldStatus"
        },
        "nature": {
          "$ref": "#/$defs/fieldNature"
        },
        "unit": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "valid",
                  "partial"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "missing",
                  "unknown",
                  "not_applicable",
                  "stale",
                  "incompatible"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "version",
        "content_hash",
        "order_hash"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "order_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "champion_id",
        "star",
        "position",
        "items",
        "traits"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "champion_id": {
          "type": "string",
          "minLength": 1
        },
        "star": {
          "$ref": "#/$defs/field"
        },
        "position": {
          "$ref": "#/$defs/field"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "combat_stats": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_index",
        "presence"
      ],
      "properties": {
        "slot_index": {
          "type": "integer",
          "minimum": 0
        },
        "presence": {
          "type": "string",
          "enum": [
            "occupied",
            "empty",
            "unknown",
            "stale",
            "incompatible"
          ]
        },
        "unit": {
          "oneOf": [
            {
              "$ref": "#/$defs/unit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required when presence=occupied; null for empty/unknown slots."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "presence": {
                "const": "occupied"
              }
            },
            "required": [
              "presence"
            ]
          },
          "then": {
            "required": [
              "unit"
            ],
            "properties": {
              "unit": {
                "$ref": "#/$defs/unit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presence": {
                "enum": [
                  "empty",
                  "unknown",
                  "stale",
                  "incompatible"
                ]
              }
            },
            "required": [
              "presence"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sequenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "player_id",
        "round",
        "decision_sequence",
        "snapshot_sequence",
        "status"
      ],
      "properties": {
        "match_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_match_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_match_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "episode_id": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "player_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "decision_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "player_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "event_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/identityStatus"
        },
        "reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "engine_match_id"
            ],
            "properties": {
              "engine_match_id": {
                "type": "string",
                "minLength": 1
              },
              "match_id": {
                "type": "string",
                "minLength": 1
              },
              "player_id": {
                "type": "string",
                "minLength": 1
              },
              "round": {
                "type": "integer",
                "minimum": 0
              },
              "decision_sequence": {
                "type": "integer",
                "minimum": 0
              },
              "snapshot_sequence": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "session_only",
                  "missing",
                  "stale",
                  "incompatible"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "version",
        "projection_hash",
        "dtype",
        "blocks",
        "canonicalization",
        "hash_scope"
      ],
      "properties": {
        "projection_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "projection_hash": {
          "$ref": "#/$defs/sha256"
        },
        "dtype": {
          "type": "string",
          "enum": [
            "float32",
            "float16",
            "bfloat16",
            "structured"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "source_paths",
              "encoding",
              "consumers"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "source_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "encoding": {
                "type": "string"
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "padding_policy": {
                "type": "string"
              },
              "presence_mask_path": {
                "type": "string"
              },
              "consumers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          }
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "output_shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "hash_scope": {
          "const": "Canonical projection definition excluding projection_hash"
        }
      }
    },
    "unitAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_instance_id"
      ],
      "properties": {
        "unit_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "is_core": {
          "$ref": "#/$defs/field"
        },
        "board_contribution": {
          "$ref": "#/$defs/field"
        },
        "composition_fit": {
          "$ref": "#/$defs/field"
        },
        "item_fit": {
          "$ref": "#/$defs/field"
        }
      }
    },
    "anchorCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "direction_id",
        "composition_id",
        "anchor_unit_id",
        "candidate_unit_ids",
        "evidence"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "direction_id": {
          "$ref": "#/$defs/field"
        },
        "composition_id": {
          "$ref": "#/$defs/field"
        },
        "anchor_unit_id": {
          "$ref": "#/$defs/field"
        },
        "candidate_unit_ids": {
          "$ref": "#/$defs/field"
        },
        "main_carry_id": {
          "$ref": "#/$defs/field"
        },
        "candidate_traits": {
          "$ref": "#/$defs/field"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchor_value": {
          "$ref": "#/$defs/field"
        },
        "transition_cost": {
          "$ref": "#/$defs/field"
        },
        "contestation": {
          "$ref": "#/$defs/field"
        },
        "reusable_owned_units": {
          "$ref": "#/$defs/field"
        },
        "shop_available": {
          "$ref": "#/$defs/field"
        }
      }
    },
    "actionOpportunityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "action_kind",
        "available"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "action_kind": {
          "type": "string",
          "enum": [
            "buy_unit",
            "buy_experience",
            "reroll_shop",
            "sell_unit",
            "deploy_or_move",
            "hold"
          ]
        },
        "champion_id": {
          "$ref": "#/$defs/field"
        },
        "unit_instance_id": {
          "$ref": "#/$defs/field"
        },
        "gold_cost": {
          "$ref": "#/$defs/field"
        },
        "direct_gold_cost": {
          "$ref": "#/$defs/field"
        },
        "lost_interest_cost": {
          "$ref": "#/$defs/field"
        },
        "opportunity_cost": {
          "$ref": "#/$defs/field"
        },
        "expected_economy_cost": {
          "$ref": "#/$defs/field"
        },
        "expected_board_delta": {
          "$ref": "#/$defs/field"
        },
        "composition_fit": {
          "$ref": "#/$defs/field"
        },
        "upgrade_value": {
          "$ref": "#/$defs/field"
        },
        "available": {
          "$ref": "#/$defs/field"
        },
        "evaluation_horizon": {
          "$ref": "#/$defs/field"
        }
      }
    }
  },
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "semantic_version",
        "structural_revision",
        "schema_hash",
        "projection",
        "hash_algorithm",
        "hash_canonicalization",
        "hash_scope",
        "evolution_policy"
      ],
      "properties": {
        "schema_id": {
          "const": "tft.ppo.observation"
        },
        "semantic_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "structural_revision": {
          "type": "integer",
          "minimum": 1
        },
        "schema_hash": {
          "$ref": "#/$defs/sha256"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "compatibility_policy": {
          "type": "string",
          "enum": [
            "compatible",
            "semantic_break",
            "structural_break",
            "explicit_migration_required",
            "new_training_lineage_required"
          ],
          "default": "new_training_lineage_required"
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "hash_canonicalization": {
          "const": "RFC8785"
        },
        "hash_scope": {
          "const": "Canonical RFC8785 form of normative schema content (field definitions, types, constraints, requiredness, semantics, catalog references and projection identity); excludes descriptions, examples and schema_hash itself"
        },
        "evolution_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patch",
            "minor",
            "major",
            "projection_change",
            "catalog_change",
            "migration",
            "training_lineage"
          ],
          "properties": {
            "patch": {
              "const": "Editorial metadata/examples/provenance clarification only; no field meaning, constraints, projection or catalog identity changes."
            },
            "minor": {
              "const": "Additive optional fields only; existing fields retain identical meaning and consumers may ignore additions only when their declared profile does not require them."
            },
            "major": {
              "const": "Any field rename/removal/reinterpretation, unit/scale/range/ordering/requiredness change, or identity-semantic change."
            },
            "projection_change": {
              "const": "Any tensor block/order/shape/dtype/encoder grouping/normalization change increments projection version and projection hash, even if semantic schema version is unchanged."
            },
            "catalog_change": {
              "const": "Content and order fingerprints are independent; any used vocabulary or ordering change updates its fingerprint, and a changed interpretation is semantically incompatible."
            },
            "migration": {
              "const": "Migration requires an explicit versioned manifest and contract tests; positional zero-padding/remapping is not evidence of semantic compatibility."
            },
            "training_lineage": {
              "const": "Semantic or projection incompatibility starts a new training lineage unless an explicitly approved and tested partial transfer is recorded."
            }
          }
        }
      },
      "description": "Hash is computed over RFC 8785 canonical JSON excluding schema_hash to avoid self-reference. Any semantic/structural/catalog/projection change that affects interpretation must change the corresponding identity."
    },
    "identity": {
      "$ref": "#/$defs/sequenceIdentity"
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "champions",
        "traits",
        "items",
        "components",
        "recipes"
      ],
      "properties": {
        "champions": {
          "$ref": "#/$defs/catalog"
        },
        "traits": {
          "$ref": "#/$defs/catalog"
        },
        "items": {
          "$ref": "#/$defs/catalog"
        },
        "components": {
          "$ref": "#/$defs/catalog"
        },
        "recipes": {
          "$ref": "#/$defs/catalog"
        },
        "trait_milestones": {
          "$ref": "#/$defs/catalog"
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "health",
        "economy"
      ],
      "properties": {
        "lifecycle": {
          "$ref": "#/$defs/field"
        },
        "health": {
          "$ref": "#/$defs/field"
        },
        "economy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gold",
            "level",
            "xp"
          ],
          "properties": {
            "gold": {
              "$ref": "#/$defs/field"
            },
            "level": {
              "$ref": "#/$defs/field"
            },
            "xp": {
              "$ref": "#/$defs/field"
            },
            "xp_to_next": {
              "$ref": "#/$defs/field"
            },
            "income": {
              "$ref": "#/$defs/field"
            },
            "interest": {
              "$ref": "#/$defs/field"
            },
            "streak_bonus": {
              "$ref": "#/$defs/field"
            },
            "shop_cost": {
              "$ref": "#/$defs/field"
            }
          }
        },
        "streaks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "win_streak": {
              "$ref": "#/$defs/field"
            },
            "loss_streak": {
              "$ref": "#/$defs/field"
            }
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board",
        "bench",
        "shop"
      ],
      "properties": {
        "board": {
          "type": "array",
          "minItems": 28,
          "maxItems": 28,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "bench": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "shop": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "component_id",
                  "count"
                ],
                "properties": {
                  "component_id": {
                    "type": "string"
                  },
                  "count": {
                    "$ref": "#/$defs/field"
                  }
                }
              }
            },
            "inventory": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "item_id",
                  "slot"
                ],
                "properties": {
                  "item_id": {
                    "type": "string"
                  },
                  "slot": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "pending_anvil": {
              "$ref": "#/$defs/field"
            }
          }
        }
      }
    },
    "derived_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positioning": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "trait_counts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "unit_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instance_id",
              "role"
            ],
            "properties": {
              "instance_id": {
                "type": "string"
              },
              "role": {
                "$ref": "#/$defs/field"
              }
            }
          }
        },
        "unit_fit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instance_id",
              "score"
            ],
            "properties": {
              "instance_id": {
                "type": "string"
              },
              "score": {
                "$ref": "#/$defs/field"
              }
            }
          }
        },
        "item_target_fit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "target_instance_id",
              "score"
            ],
            "properties": {
              "item_id": {
                "type": "string"
              },
              "target_instance_id": {
                "type": "string"
              },
              "score": {
                "$ref": "#/$defs/field"
              }
            }
          }
        },
        "economic_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stage": {
              "$ref": "#/$defs/field"
            },
            "interest_if_resolved_now": {
