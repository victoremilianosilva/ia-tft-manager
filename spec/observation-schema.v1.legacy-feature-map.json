  ],
  "global_consumers": [
    {
      "consumer": "TFTPolicy.encode",
      "behavior": "fixed prefix/board/middle/candidate-tail slicing; board CNN plus global MLP"
    },
    {
      "consumer": "TFTPolicy._economic_context_features",
      "behavior": "derives five extra economic features from core fields and legacy strategy one-hot"
    },
    {
      "consumer": "TFTPolicy._candidate_features",
      "behavior": "decodes final 14*8 values as bench and shop candidates"
    },
    {
      "consumer": "TFTPolicy._item_state_features",
      "behavior": "decodes item block immediately before candidate tail"
    },
    {
      "consumer": "TFTPolicy.get_value",
      "behavior": "ignores masks; critic sees encoded observation only"
    },
    {
      "consumer": "Trainer/RolloutBuffer",
      "behavior": "stores observation and action masks separately; no shared decision identity in current tensor contract"
    }
  ],
  "global_gaps": [
    "No schema ID/version/hash in observation payload.",
    "No champion/trait/item/component/recipe catalog fingerprints or order hashes.",
    "No explicit match/player/round/decision/snapshot identity in PPO observation.",
    "Missing, unknown, not-applicable, padding, empty and zero observed are not consistently distinct.",
    "Eliminated players receive an all-zero vector.",
    "No final producer assertion verifies written offset equals observation_dim().",
    "Trait synergy top-five slots are state-order dependent.",
    "Legacy strategy and composition blocks still depend on StrategyInfo.",
    "Board channel documentation in policy.py differs from producer order.",
    "Masks are separate and not correlated to observation identity; critic ignores masks."
  ]
}
