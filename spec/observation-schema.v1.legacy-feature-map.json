          "requires slot identity"
        ],
        [
          "role",
          "UnitCombatClassifier.classify",
          "derived",
          "role_state_value",
          "comment in policy.py documents a different channel order"
        ],
        [
          "strength_proxy",
          "champion cost + star",
          "estimated",
          "min(1,cost/5*0.5 + star/3*0.5)",
          "proxy, not combat power"
        ]
      ]
    },
    {
