          "observed",
          "0/1",
          "zero when empty"
        ],
        [
          "champion_cost",
          "ChampionCatalog.cost",
          "observed",
          "cost /5",
          "requires catalog mapping"
        ],
        [
          "star",
          "UnitInstance.star",
          "observed",
