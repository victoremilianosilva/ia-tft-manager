{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy PPO Observation Feature Map — Audit Draft",
  "description": "Field/block inventory for migration planning only. This is not the new canonical Observation Schema and does not authorize preserving legacy offsets.",
  "audited_branch": "new-arquiteture",
  "audited_commit": "3575d21cc0f7dbb5544d75526bd96939b37f5c96",
  "dimension_formula": "7097 + 4*T",
  "T_definition": "number of unique observation_trait_names generated from ChampionCatalog iteration order",
  "blocks": [
    {
      "id": "core",
      "range": "[0,22)",
      "shape": [
        22
      ],
      "fields": [
        [
          "hp",
          "player.hp",
          "observed",
          "ratio /100",
          "player health; no explicit validity bit"
        ],
        [
          "gold",
          "economy.gold",
          "observed",
          "gold /50",
          "duplicated in extra block"
        ],
        [
          "level",
          "economy.level",
          "observed",
          "level /9",
          "duplicated in extra block"
        ],
        [
          "xp_to_next_ratio",
          "economy.xp / max(1,xp_to_next)",
          "derived",
          "ratio",
          "xp_to_next denominator is implicit"
        ],
        [
          "win_streak",
          "economy.win_streak",
          "observed",
          "/10",
          "streak"
        ],
        [
          "loss_streak",
          "economy.loss_streak",
          "observed",
          "/10",
          "streak"
        ],
        [
          "round_fraction",
          "round+1",
          "derived",
          "r/(r+10)",
          "policy inverses this to estimate round"
        ],
        [
          "board_count_over_level",
          "board_count / max(1,level)",
          "derived",
          "ratio",
          "can exceed 1 if board over capacity"
        ],
        [
          "bench_count_ratio",
          "bench_count / bench_slots",
          "derived",
          "ratio",
          "bench occupancy"
        ],
        [
          "shop_present",
          "constant 1",
          "synthetic",
          "1.0",
          "does not encode actual per-slot presence"
        ],
        [
          "legacy_strategy_one_hot",
          "StrategyInfo.strategy",
          "legacy_decision",
          "7-way one-hot [10:17]",
          "missing StrategyInfo defaults to ECON; Python derives nominal strategy with argmax"
        ],
        [
          "reserved_core_tail",
          "constant zeros",
          "synthetic_padding",
          "5 zeros",
          "reserved; not missing indicator"
        ]
      ]
    },
    {
